{
  "name": "story-interview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev-server.js",
    "worker:dev": "wrangler dev --config workers/wrangler.jsonc --port 8787",
    "db:init": "wrangler d1 migrations apply story-users --local --config workers/wrangler.jsonc",
    "admin:promote": "node workers/promote-admin.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser-e2e.js",
    "check": "node --check script.js && node --check auth.js && node --check admin.js && node --check workers/src/index.js",
    "build:worker": "wrangler deploy --dry-run --config workers/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "wrangler": "4.107.0",
    "playwright": "latest",
    "jsdom": "latest"
  }
}
