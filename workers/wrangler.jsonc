{
 "$schema":"../node_modules/wrangler/config-schema.json",
 "name":"story-interview-auth",
 "main":"src/index.js",
 "compatibility_date":"2026-07-08",
 "compatibility_flags":["nodejs_compat"],
 "observability":{"enabled":true},
 "vars":{"ALLOWED_ORIGINS":"http://localhost:8000,http://127.0.0.1:8000,http://localhost:8788,http://127.0.0.1:8788"},
 "d1_databases":[{"binding":"DB","database_name":"story-users","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
 "env":{
  "production":{
   "name":"story-interview-auth-production",
   "vars":{"GITHUB_OWNER":"Artificial-rhapsody","GITHUB_REPO":"NKHH","GITHUB_BRANCH":"main","ALLOWED_ORIGINS":"https://artificial-rhapsody.github.io"},
   "secrets":{"required":["GITHUB_TOKEN"]},
   "d1_databases":[{"binding":"DB","database_name":"story-users-production","database_id":"9fe7b4ce-258b-42d3-b2b4-fc28a125832d","migrations_dir":"migrations"}]
  }
 }
}
